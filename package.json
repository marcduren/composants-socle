{
  "name": "socle",
  "version": "0.1.2",
  "description": "Composants Vue 3 accessibles, bâtis sur les éléments natifs du navigateur (<dialog>, popover, CSS Anchor Positioning).",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./*.vue": "./*.vue",
    "./socle.css": "./socle.css",
    "./classes": "./classes.ts",
    "./table": "./table.ts"
  },
  "files": [
    "index.ts",
    "classes.ts",
    "table.ts",
    "*.vue",
    "socle.css"
  ],
  "sideEffects": [
    "*.vue",
    "*.css"
  ],
  "keywords": [
    "vue",
    "components",
    "tailwindcss",
    "accessibility",
    "dialog",
    "popover",
    "table",
    "anchor-positioning"
  ],
  "peerDependencies": {
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0"
  }
}
